{
  "$schema": "https://blockstudio.dev/schema/block",
  "name": "mpx/column-cover",
  "title": "Column Cover",
  "category": "metapixels-blocks",
  "icon": "cover-image",
  "description": "Full-bleed cover image with a content box (heading, paragraph, button) overlaid on the left — same children as Hero.",
  "keywords": ["cover", "column", "banner", "image", "overlay", "box"],
  "supports": {
    "html": false,
    "align": ["full"],
    "anchor": true,
    "customClassName": true
  },
  "blockstudio": {
    "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\"><rect width=\"24\" height=\"24\" rx=\"3\" fill=\"#101920\"/><rect x=\"3.25\" y=\"4.25\" width=\"17.5\" height=\"15.5\" rx=\"1.5\" stroke=\"#FF884B\" stroke-width=\"1.5\"/><rect x=\"5\" y=\"7\" width=\"8\" height=\"10\" rx=\"1.5\" fill=\"#FF884B\" opacity=\"0.85\"/></svg>",
    "attributes": [
      {
        "type": "group",
        "title": "Image",
        "attributes": [
          {
            "id": "cover_image",
            "type": "files",
            "label": "Cover image",
            "help": "Fills the whole block. Prefer a subject framed toward the right so the content box stays clear on the left.",
            "allowedTypes": ["image"],
            "multiple": false,
            "returnFormat": "object"
          },
          {
            "id": "image_position_x",
            "type": "range",
            "label": "Horizontal position",
            "help": "0% = left, 100% = right.",
            "default": 70,
            "min": 0,
            "max": 100,
            "step": 1,
            "allowReset": true
          },
          {
            "id": "image_position_y",
            "type": "range",
            "label": "Vertical position",
            "help": "0% = top, 100% = bottom.",
            "default": 50,
            "min": 0,
            "max": 100,
            "step": 1,
            "allowReset": true
          }
        ]
      },
      {
        "type": "group",
        "title": "Content box",
        "attributes": [
          {
            "type": "custom/background_colour",
            "overrides": {
              "bg_colour": {
                "label": "Box background",
                "default": {
                  "value": "#00000070",
                  "name": "Black 44%",
                  "slug": "bg-black-44"
                }
              }
            }
          },
          {
            "id": "box_position",
            "type": "select",
            "label": "Box position",
            "default": "left",
            "returnFormat": "value",
            "options": [
              { "value": "left", "label": "Left" },
              { "value": "right", "label": "Right" }
            ]
          },
          {
            "type": "custom/section_padding",
            "overrides": {
              "section_padding": {
                "default": ["py-clamp-xl"]
              }
            }
          }
        ]
      }
    ]
  }
}
