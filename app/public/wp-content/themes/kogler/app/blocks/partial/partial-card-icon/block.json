{
  "$schema": "https://blockstudio.dev/schema/block",
  "name": "mpx/partial-card-icon",
  "title": "Card (Icon)",
  "category": "metapixels-partials",
  "icon": "art",
  "description": "Feature card with an icon child plus heading and paragraph. Optionally place the icon beside the text, or use a large centered icon tile. Background comes from the parent Cards block.",
  "keywords": [
    "card",
    "icon",
    "feature"
  ],
  "parent": [
    "mpx/partial-cards"
  ],
  "usesContext": [
    "mpx/partial-cards"
  ],
  "supports": {
    "html": false,
    "lock": false
  },
  "blockstudio": {
    "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\"><rect width=\"24\" height=\"24\" rx=\"3\" fill=\"#101920\"/><rect x=\"3.5\" y=\"4.5\" width=\"17\" height=\"15\" rx=\"1.5\" stroke=\"#FF884B\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"9\" r=\"2.35\" fill=\"#FF884B\"/><path d=\"M12 7.55l0.55 1.15 1.25.18-0.9.88.21 1.25L12 10.4l-1.11.61.21-1.25-.9-.88 1.25-.18L12 7.55Z\" fill=\"#101920\"/><rect x=\"7\" y=\"13.25\" width=\"10\" height=\"1.35\" rx=\"0.7\" fill=\"#FF884B\"/><rect x=\"8.5\" y=\"15.75\" width=\"7\" height=\"1.1\" rx=\"0.55\" fill=\"#FF884B\" opacity=\"0.7\"/></svg>",
    "attributes": [
      {
        "id": "full_width_icon",
        "type": "toggle",
        "label": "Full-width icon",
        "help": "Large centered glyph (no badge) with tile-style padding. Use for label-style cards.",
        "default": false
      },
      {
        "id": "horizontal_layout",
        "type": "toggle",
        "label": "Icon beside content",
        "help": "From tablet up, place the icon to the left of the text. Mobile stays stacked.",
        "default": false,
        "conditions": [
          [
            {
              "id": "full_width_icon",
              "operator": "!=",
              "value": true
            }
          ]
        ]
      },
      {
        "type": "custom/grid_item_width"
      }
    ]
  }
}
