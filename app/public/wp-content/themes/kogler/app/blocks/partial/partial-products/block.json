{
  "$schema": "https://blockstudio.dev/schema/block",
  "name": "mpx/partial-products",
  "title": "Products",
  "category": "metapixels-partials",
  "icon": "products",
  "description": "Product card grid (4 per row). Show latest products, a custom selection, or the latest products from a category.",
  "keywords": [
    "products",
    "woocommerce",
    "shop",
    "cards",
    "catalog"
  ],
  "parent": [
    "mpx/one-column"
  ],
  "supports": {
    "html": false,
    "lock": false
  },
  "blockstudio": {
    "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\"><rect width=\"24\" height=\"24\" rx=\"3\" fill=\"#101920\"/><rect x=\"4\" y=\"5\" width=\"7\" height=\"6\" rx=\"1\" fill=\"#FF884B\"/><rect x=\"13\" y=\"5\" width=\"7\" height=\"6\" rx=\"1\" fill=\"#FF884B\" opacity=\"0.85\"/><rect x=\"4\" y=\"13\" width=\"7\" height=\"6\" rx=\"1\" fill=\"#FF884B\" opacity=\"0.7\"/><rect x=\"13\" y=\"13\" width=\"7\" height=\"6\" rx=\"1\" fill=\"#FF884B\" opacity=\"0.55\"/></svg>",
    "attributes": [
      {
        "type": "group",
        "title": "Products",
        "attributes": [
          {
            "id": "source",
            "type": "select",
            "label": "Products to show",
            "help": "Latest four by default, or pick products / filter by category.",
            "default": "latest",
            "returnFormat": "value",
            "options": [
              {
                "value": "latest",
                "label": "Latest products"
              },
              {
                "value": "custom",
                "label": "Custom selection"
              },
              {
                "value": "category",
                "label": "Latest by category"
              }
            ]
          },
          {
            "id": "count",
            "type": "number",
            "label": "Number of products",
            "help": "How many product cards to show (default 4).",
            "default": 4,
            "min": 1,
            "max": 12,
            "conditions": [
              [
                {
                  "id": "source",
                  "operator": "!=",
                  "value": "custom"
                }
              ]
            ]
          },
          {
            "id": "products",
            "type": "select",
            "label": "Products",
            "help": "Choose the products to display. Order matches your selection.",
            "multiple": true,
            "stylisedUi": true,
            "populate": {
              "type": "query",
              "query": "posts",
              "fetch": true,
              "arguments": {
                "post_type": "product",
                "post_status": "publish",
                "numberposts": 20,
                "orderby": "title",
                "order": "ASC"
              },
              "returnFormat": {
                "value": "ID",
                "label": "post_title"
              }
            },
            "conditions": [
              [
                {
                  "id": "source",
                  "operator": "==",
                  "value": "custom"
                }
              ]
            ]
          },
          {
            "id": "category",
            "type": "select",
            "label": "Category",
            "help": "Show the latest products from this category.",
            "stylisedUi": true,
            "populate": {
              "type": "query",
              "query": "terms",
              "arguments": {
                "taxonomy": "product_cat",
                "hide_empty": false
              },
              "returnFormat": {
                "value": "term_id",
                "label": "name"
              }
            },
            "conditions": [
              [
                {
                  "id": "source",
                  "operator": "==",
                  "value": "category"
                }
              ]
            ]
          }
        ]
      }
    ]
  }
}
